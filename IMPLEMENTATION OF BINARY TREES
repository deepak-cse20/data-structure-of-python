class Node:
    def __init__(self, data):
        self.data = data
        self.left = None
        self.right = None


def create_tree():
    data=input("Enter node data(-1 if no node):")
    if data=="-1":
        return None
    root=Node(data)
    print(f"Enter value of left child {data}")
    root.left=create_tree()

    print(f"Enter value of right child {data}")
    root.right=create_tree()

    return root
def inorder(root):
    if root is None:
        return None
    inorder(root.left)
    print(root.data,end=" -> ")
    inorder(root.right)
def preorder(root):
    if root is None:
        return None
    print(root.data,end=" -> ")
    preorder(root.left)
    preorder(root.right)
def postorder(root):
    if root is None:
        return None
    postorder(root.left)
    postorder(root.right)
    print(root.data,end=" -> ")
root=create_tree()
print("\nInorder: ",end="")
inorder(root)
print("\nPreorder: ",end="")
preorder(root)
print("\nPostorder: ",end="")
postorder(root)
